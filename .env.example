# Procam CRM — environment variables
# Copy to .env, fill in, then: chmod 600 .env
# Never commit .env. Secrets below are deliberately blank: a placeholder
# that "works" is a secret everyone who reads this file knows.
# Check a configured server with: .venv/bin/python scripts/production_preflight.py
# Full reference: docs/operations/AI_CONFIGURATION_GUIDE.md and
# docs/operations/ADMINISTRATOR_GUIDE.md

# ─── Core ────────────────────────────────────────────────────────────
# REQUIRED in production. 32+ random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Unset, every gunicorn worker invents its own key: sessions and CSRF
# tokens break between workers and on every restart.
SECRET_KEY=

# Production (Azure VM): SQLite at /var/www/procam-crm/procam_crm.db
DATABASE_URL=sqlite:////var/www/procam-crm/procam_crm.db

# Behind nginx at procamlogitech.com/CRM/
URL_PREFIX=/CRM

# Secure cookies. Only a local http:// dev box may set this to false.
SESSION_COOKIE_SECURE=true
DEBUG=false
LOG_LEVEL=INFO

# gunicorn on the VM binds 127.0.0.1:8002 (see the systemd unit)
PORT=8002

# Only used to seed PCM001 into an EMPTY database. 12+ characters, and
# never a value that has appeared in any document. Remove it from .env
# once the super admin exists.
ADMIN_INITIAL_PASSWORD=

# Content Security Policy: enforce (default) or report-only (back-out switch)
CSP_MODE=enforce

# Shared rate-limit counters across gunicorn workers (optional), e.g.
# redis://127.0.0.1:6379/1 — in-memory per worker when unset
RATELIMIT_STORAGE_URI=

# First-boot employee seed (optional, git-ignored; see app.py)
# SEED_EMPLOYEES_CSV=/var/www/procam-crm/data/private/seed_employees.csv

# Where uploads are stored (defaults shown)
# CRM_UPLOAD_ROOT=/var/www/procam-crm/instance/uploads
# EMAIL_INGEST_STORAGE_ROOT=/var/www/procam-crm/uploads/email_leads

# ─── Microsoft Graph: leads mailbox ──────────────────────────────────
# App registration (client credentials). Needs, as APPLICATION permissions
# with admin consent: Mail.Read (ingest and recovery) and Mail.Send
# (assignment emails), scoped to leads@procamgroup.in with an
# ApplicationAccessPolicy. See docs/operations/GRAPH_SETUP_GUIDE.md.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

EMAIL_INGESTION_MODE=mailbox
CRM_INBOX_EMAIL=leads@procamgroup.in
EMAIL_WEBHOOK_URL=https://procamlogitech.com/CRM/api/email/webhook
# REQUIRED for the webhook. 16+ random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset, the webhook refuses every notification.
EMAIL_WEBHOOK_SECRET=

# enforce = the classifier decides what becomes a lead (default)
# observe = classify and record, but create leads as before
# off     = classifier not run
LEAD_INTAKE_MODE=enforce

# Assignment notification emails from the leads mailbox. On by default;
# until Mail.Send is granted each send fails with 403 and is logged.
NOTIFY_ENABLED=true
NOTIFY_FROM=leads@procamgroup.in
CRM_BASE_URL=https://procamlogitech.com/CRM

# Extra internal domains, comma-separated (procamlogistics.com and
# procamgroup.in are always internal)
INTERNAL_EMAIL_DOMAINS=
EMAIL_INGEST_SKIP_DOMAINS=procamlogistics.com,procamgroup.in

# Legacy poller / recovery script mailbox. Recovery falls back to
# CRM_INBOX_EMAIL when unset.
EMAIL_INGEST_MAILBOX=leads@procamgroup.in
EMAIL_INGEST_LOOKBACK_HOURS=26
EMAIL_INGEST_MARK_AS_READ=false

# ─── Procam AI Copilot ───────────────────────────────────────────────
# Deterministic answers work with none of these set.
# A self-hosted, OpenAI-compatible endpoint on Procam's network. Public AI
# APIs are refused; the preflight fails any host that is not provably
# private. Example: http://10.0.0.7:11434/v1
PROCAM_AI_BASE_URL=
PROCAM_AI_MODEL=qwen2.5:14b-instruct
PROCAM_AI_CLASSIFIER_MODEL=
PROCAM_AI_KEY=
PROCAM_AI_TIMEOUT=20
# Self-hosted embedder for semantic search (lexical search without it)
PROCAM_AI_EMBED_URL=
PROCAM_AI_EMBED_MODEL=nomic-embed-text
# Copilot write actions (propose → confirm). Leave off until a business
# owner approves them.
PROCAM_AI_ACTIONS=off

# ─── External AI providers (public) ──────────────────────────────────
# Each of these sends CRM or email content to a third party. Whether that
# is acceptable is a business decision — see the AI Configuration Guide.
# Email extraction (primary) and the intake classifier's AI step
GROQ_API_KEY=
EMAIL_AI_MODEL_GROQ=openai/gpt-oss-120b
# AI step inside the intake classifier (needs a Groq or Anthropic key)
LEAD_INTAKE_AI=off
LEAD_INTAKE_AI_TIMEOUT=12
# AI Outreach, business card OCR, fallback extraction
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
EMAIL_AI_FALLBACK_THRESHOLD=0.55
AI_DAILY_TOKEN_BUDGET=180000
EMAIL_AI_MAX_BODY_CHARS=3500
EMAIL_AI_MAX_TOKENS=1500

# ─── Operations monitoring (scripts/ops_status.py, /CRM/admin/ops) ───
# OPS_STATUS_FILE=/var/www/procam-crm/instance/ops_status.json
# OPS_HEALTH_URL=http://127.0.0.1:8002/healthz
# OPS_SERVICE_NAME=procam-crm
# Graph client secret expiry, copied from Entra (YYYY-MM-DD), for the
# expiry warning — Graph cannot report it without extra permissions
GRAPH_CLIENT_SECRET_EXPIRES=

# Static delegated token for the legacy news fetch (optional)
MS365_TOKEN=
