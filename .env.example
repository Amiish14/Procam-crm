# Procam ProConnect CRM — Environment Variables
# Copy this to .env and fill in values

# Flask secret key (change in production!)
SECRET_KEY=procam-crm-secret-change-me-2025

# Database URL
# SQLite for local dev:
DATABASE_URL=sqlite:///procam_crm.db
# PostgreSQL for production (Render provides this automatically):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Microsoft 365 / Outlook token for news intelligence fetch
# Get via OAuth2 flow from Azure AD app registration
MS365_TOKEN=

# ─── PCM001 Super Admin — first-boot password ───
# Used ONLY when the DB is empty. After the first successful login the
# admin is forced to change it. Value never persists in source.
# REQUIRED — must be set to a strong (>=12 char) value BEFORE first boot.
# The app will refuse to start otherwise.
ADMIN_INITIAL_PASSWORD=

# ─── Anthropic / Claude (AI Outreach) ───
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ─── Reverse-proxy prefix ───
# When running behind nginx at procamlogictech.com/CRM/, set this so all
# generated URLs (login redirects, static, etc.) carry the prefix.
# Leave blank for local dev on http://localhost:5000/.
URL_PREFIX=/CRM

# Debug mode (never true in production)
DEBUG=false

# Port (Render sets this automatically; on the shared VM we use 8001)
PORT=8001

# ─── Microsoft Graph email ingest ───
# Auth (Azure AD app "Procam CRM Email Ingest", Mail.Read app permission)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# v2026-08-31 — leads@procamgroup.in is the sole live source. Ingestion
# happens in real time via a Microsoft Graph subscription that pushes to
# /api/email/webhook. The old 09:00 IST poll is retired.
EMAIL_INGESTION_MODE=mailbox
CRM_INBOX_EMAIL=leads@procamgroup.in
EMAIL_WEBHOOK_SECRET=set-a-random-string-here          # Graph echoes this on every notification
EMAIL_WEBHOOK_URL=https://procamlogitech.com/CRM/api/email/webhook

# v2026-09 — Every message that lands in the leads inbox becomes a Lead;
# the mailbox itself is the filter, so there is nothing to configure here.
# What the pipeline does do is unwrap forwards, so the Lead is the ORIGINAL
# prospect inside the forward rather than the employee who forwarded it.
# See docs/LEAD_INGESTION_POLICY.md.

# Legacy — only used if EMAIL_INGESTION_MODE is manually flipped to
# 'azure_api' for a one-off backfill via scripts/email_ingest.py.
EMAIL_INGEST_MAILBOX=leads@procamgroup.in
EMAIL_INGEST_LOOKBACK_HOURS=26
EMAIL_INGEST_MARK_AS_READ=false
EMAIL_INGEST_SKIP_DOMAINS=procamlogistics.com,procamgroup.in
