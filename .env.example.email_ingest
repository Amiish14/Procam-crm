# ─── v2026-08 — Email ingestion (mailbox mode) env vars ────────────────
# Append these to your existing .env once the CRM inbox address is
# provisioned. Until then the old Azure-API poll pipeline keeps running
# unchanged (leave EMAIL_INGESTION_MODE unset or set to 'azure_api').

# Which ingestion mode to run.
#   azure_api  →  existing poll pipeline (default; back-compat)
#   mailbox    →  webhook-driven; requires Graph subscription
EMAIL_INGESTION_MODE=azure_api

# The dedicated CRM mailbox address (IT is provisioning). Never hardcode
# this in code — this file is the ONLY place it should appear.
CRM_INBOX_EMAIL=

# Public HTTPS URL of the webhook endpoint. Graph will POST notifications
# here. Must be reachable from Microsoft's network.
EMAIL_WEBHOOK_URL=https://<your-domain>/api/email/webhook

# Random string. Graph echoes this on every notification and we compare
# server-side so unauthenticated POSTs are dropped. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_WEBHOOK_SECRET=

# These already exist for the poll pipeline; the webhook uses the same
# Graph app registration and credentials.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Which mailbox the poll pipeline reads (used only when
# EMAIL_INGESTION_MODE=azure_api). Kept for rollback.
EMAIL_INGEST_MAILBOX=
