[Unit]
Description=Daily Procam CRM Data Quality snapshot

[Timer]
# After the backup (01:30) and the Copilot index (02:15), and before the
# morning report (03:00 UTC / 08:30 IST), so no two of them compete for
# the one SQLite file.
OnCalendar=*-*-* 02:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
