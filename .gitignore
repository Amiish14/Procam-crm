venv/
.venv/
env/
*.db
*.db.bak*
# A copy of the database is a copy of the database whatever it is
# called. procam_crm.db.safe-backup matched neither rule above.
*.db-backup
*.db.safe-backup
*.sqlite
*.sqlite3
*.sqlite3.bak*
*.sqlite3
__pycache__/
*.pyc
*.pyo
# Every .env, not just the bare one. A dated backup such as
# .env.backup-2026-10-06-132059 is as full of live secrets as the
# original, and the exact-match rule here let two of them sit
# untracked in the working tree on the server until a pull tripped
# over them.
.env*
# The two committed samples carry no secrets and stay visible.
!.env.example
!.env.example.*
.DS_Store
*.egg-info/
dist/
build/
instance/
.pytest_cache/

# Lead attachments written by the email ingest (EMAIL_INGEST_STORAGE_ROOT
# defaults to ./uploads/email_leads). Never commit customer files.
uploads/
data/imports/

# Employee and customer lists hold personal data. Scripts read them from
# data/private/ on the machine that runs them; never commit them.
data/private/
data/employee_directory.csv
data/employee_emails_*.txt

# Runtime state written next to the app on the server
.leads_subscription_id
cookies.txt
*.log

# Data-quality CSVs hold customer data — never commit them
reports/
backups/
# The repair workbook is generated from live data and contains
# client names. It belongs on the server and in somebody's hands,
# not in the repository.
docs/exports/*.xlsx
